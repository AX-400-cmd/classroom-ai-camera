<view class="page">
  <view class="card">
    <view class="row">
      <button
        wx:for="{{ranges}}"
        wx:key="value"
        class="btn small {{range === item.value ? 'primary' : 'ghost'}}"
        data-value="{{item.value}}"
        bindtap="switchRange"
      >{{item.label}}</button>
    </view>
  </view>

  <view wx:if="{{err}}" class="notice error">{{err}}</view>

  <view class="cards">
    <view wx:for="{{cards}}" wx:key="label" class="card stat-card">
      <text class="stat-value">{{item.value}}</text>
      <text class="stat-label tiny muted">{{item.label}}</text>
    </view>
  </view>

  <view class="card">
    <view class="card-title">24 小时告警分布</view>
    <view class="chart">
      <view wx:for="{{hours}}" wx:key="h" class="bar-col">
        <view class="bar-wrap">
          <view class="bar" style="height:{{item.pct}}%"></view>
        </view>
        <text class="bar-label">{{item.h}}</text>
      </view>
    </view>
    <view class="tiny muted" style="margin-top:16rpx">
      到课人数取统计区间内画面人数峰值。数据来自服务端本地数据库，重启服务不丢。
    </view>
  </view>

  <view class="tiny muted center" wx:if="{{updated}}">更新于 {{updated}}</view>
</view>
