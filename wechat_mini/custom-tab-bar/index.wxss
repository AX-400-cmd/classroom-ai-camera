.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  background: #151a21;
  border-top: 1rpx solid #26303b;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}

.tabbar-item {
  flex: 1;
  height: 110rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

/* 用圆点代替图标，省掉图标文件依赖（正式项目可换成 iconPath 图片） */
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #4a5563;
  transition: all 0.15s;
}

.tabbar-item.active .dot {
  background: #ff8a3d;
  width: 28rpx;
  border-radius: 6rpx;
}

.label {
  font-size: 22rpx;
  color: #8a94a6;
}

.tabbar-item.active .label {
  color: #ff8a3d;
  font-weight: 600;
}
